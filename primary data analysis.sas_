6options validvarname=v7;

proc import datafile="/home/u64465901/PRIMARY DATA.xlsx"
    out=farmers
    dbms=xlsx
    replace;
    getnames=yes;
run;

proc contents data=farmers varnum;
run;

proc means data=farmers n nmiss;
run;
proc freq data=farmers;
tables _character_ / missing;
run;

ods _all_ close;
ods graphics on;

ods pdf file="/home/u64465901/result.pdf"
style=journal
startpage=yes;

proc means data=farmers
n
mean
std
median
min
q1
q3
max
maxdec=2;

var
Age
Height
Weight
BMI
Household_Size
Household_Income
Years_in_Farming
Months_Farm_Work
Landholding
Years_pesticide_handling
regular_medicines_count
Number_of_visits
Number_of_admissions
Consultation_Fees
Investigations_Tests
Medicines
Transport
Other_Expenses
Total_expenses;

run;

proc freq data=farmers;

tables

Sex
Marital_Status
Education_Level
Family_type
SES
Primary_Occupation
BMI_CODE
Tobacco_Use
Alcohol_Use
Physical_Activity
Hypertension
Diabetes_Mellitus
